DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
NEXT_PUBLIC_APP_NAME=趣灵
NEXT_PUBLIC_MAX_STEPS=5

# Public beta mode: static | invite | open
PUBLIC_FLOW_MODE=static
DYNAMIC_GENERATION_ENABLED=0

# Local is for development only. Production dynamic modes require upstash.
PUBLIC_BETA_STORAGE=local
PUBLIC_BETA_NAMESPACE=aha-flash:public-beta
PUBLIC_BETA_LOCAL_FILE=data/public-beta/store.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DYNAMIC_DAILY_REQUEST_LIMIT=20
DYNAMIC_DAILY_TOKEN_LIMIT=200000
DYNAMIC_CLIENT_WINDOW_LIMIT=3
DYNAMIC_CLIENT_WINDOW_MS=3600000
DYNAMIC_MODEL_TOKEN_RESERVATION=10000
DYNAMIC_CACHE_TTL_SECONDS=86400
DYNAMIC_GENERATION_VERSION=v6-public-beta-1

ANALYTICS_CLIENT_WINDOW_LIMIT=120
ANALYTICS_CLIENT_WINDOW_MS=60000
FEEDBACK_CLIENT_WINDOW_LIMIT=10
FEEDBACK_CLIENT_WINDOW_MS=60000

INVITE_CODE_PEPPER=
ADMIN_METRICS_SECRET=
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
